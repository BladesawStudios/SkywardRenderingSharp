<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Renders Skyward Sword HD models. The game's shaders are one GX (Wii) emulator configured by #defines;
    this library reproduces that as a single uber shader driven by uniforms, reads the game's own BRRES
    models and XTX textures, and runs the painterly post chain (depth-of-field, paint dilation, bloom).
  -->

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Renders Skyward Sword HD models with a GX uber shader and the game's painterly post-processing.</Description>
    <RyujinxLibs>$(SrsLibRoot)\ShaderLibrary\ShaderLibrary.CompileTool\Libs</RyujinxLibs>
  </PropertyGroup>

  <!-- The libraries are submodules in lib (SrsLibRoot, set in Directory.Build.props): the game's formats, and Ryujinx's Maxwell translator from ShaderLibrary. -->
  <ItemGroup>
    <ProjectReference Include="$(SrsLibRoot)\LzSharp\src\LzSharp\LzSharp.csproj" />
    <ProjectReference Include="$(SrsLibRoot)\U8Sharp\src\U8Sharp\U8Sharp.csproj" />
    <ProjectReference Include="$(SrsLibRoot)\BresSharp\src\BresSharp\BresSharp.csproj" />
    <ProjectReference Include="$(SrsLibRoot)\XtxSharp\src\XtxSharp\XtxSharp.csproj" />
    <ProjectReference Include="$(SrsLibRoot)\TexSharp\src\TexSharp\TexSharp.csproj" />
    <ProjectReference Include="$(SrsLibRoot)\RevolutionEggSharp\src\RevolutionEggSharp\RevolutionEggSharp.csproj" />
    <ProjectReference Include="$(SrsLibRoot)\SkywardPaletteSharp\src\SkywardPaletteSharp\SkywardPaletteSharp.csproj" />
    <Reference Include="Ryujinx.Common" HintPath="$(RyujinxLibs)\Ryujinx.Common.dll" />
    <Reference Include="Ryujinx.Graphics.Shader" HintPath="$(RyujinxLibs)\Ryujinx.Graphics.Shader.dll" />
    <Reference Include="Spv.Generator" HintPath="$(RyujinxLibs)\Spv.Generator.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SkywardRenderingSharp.TestBench" />
    <InternalsVisibleTo Include="SkywardRenderingSharp.Tests" />
    <EmbeddedResource Include="Glsl\**\*" LogicalName="Glsl/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
