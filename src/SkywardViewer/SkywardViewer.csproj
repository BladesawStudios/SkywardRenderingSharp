<Project Sdk="Microsoft.NET.Sdk">

  <!-- A realtime window onto SkywardRenderingSharp: pick any model or stage by ID, orbit it, play its animations, toggle the post chain. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SkywardViewer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL.Extensions.ImGui" Version="2.23.0" />
    <ProjectReference Include="..\SkywardRenderingSharp\SkywardRenderingSharp.csproj" />
  </ItemGroup>

</Project>
